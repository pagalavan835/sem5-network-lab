#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

#define PORT 8080
#define BUFFER_SIZE 1024

int main() {
    int server_fd;
    struct sockaddr_in server_addr, client_addr;
    socklen_t addr_len = sizeof(client_addr);
    char buffer[BUFFER_SIZE];

    // 1. Create UDP socket
    if ((server_fd = socket(AF_INET, SOCK_DGRAM, 0)) < 0) {
        perror("Socket creation failed");
        exit(EXIT_FAILURE);
    }

    // 2. Clear and populate server address structure
    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_addr.s_addr = INADDR_ANY;
    server_addr.sin_port = htons(PORT);

    // 3. Bind the socket to the port
    if (bind(server_fd, (struct sockaddr *)&server_addr, sizeof(server_addr)) < 0) {
        perror("Bind failed");
        close(server_fd);
        exit(EXIT_FAILURE);
    }
    
    printf("=========================================\n");
    printf("        UDP SERVER IS RUNNING            \n");
    printf("=========================================\n");
    printf("Bind successful on port %d\n", PORT);
    printf("Waiting for messages from clients...\n\n");

    // 4. Communication loop
    while (1) {
        memset(buffer, 0, BUFFER_SIZE);
        
        // Receive message from client
        int n = recvfrom(server_fd, (char *)buffer, BUFFER_SIZE - 1, 0,
                         (struct sockaddr *)&client_addr, &addr_len);
        if (n < 0) {
            perror("Receive failed");
            continue;
        }

        buffer[n] = '\0';

        // Extract client IP address for logging
        char client_ip[INET_ADDRSTRLEN];
        inet_ntop(AF_INET, &(client_addr.sin_addr), client_ip, INET_ADDRSTRLEN);
        printf("[Client %s:%d] -> %s\n", client_ip, ntohs(client_addr.sin_port), buffer);

        // Send a reply back to the client
        char *reply = "Message successfully received by server!";
        sendto(server_fd, (const char *)reply, strlen(reply), 0,
               (struct sockaddr *)&client_addr, addr_len);
    }

    // 5. Close the socket (unreachable in infinite loop, but good practice)
    close(server_fd);
    return 0;
}
