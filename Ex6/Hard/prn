#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <stdint.h>
#include <termios.h>

#define PORT 9 055
#define BUFFER_SIZE 1024

/* Function to read password invisibly */
void get_invisible_password(char *password, size_t max_len) {
    struct termios oldt, newt;
    tcgetattr(STDIN_FILENO, &oldt);
    newt = oldt;
    newt.c_lflag &= ~(ECHO);
    tcsetattr(STDIN_FILENO, TCSANOW, &newt);

    if (fgets(password, max_len, stdin) != NULL) {
        size_t len = strlen(password);
        if (len > 0 && password[len - 1] == '\n') {
            password[len - 1] = '\0';
        }
    }

    tcsetattr(STDIN_FILENO, TCSANOW, &oldt);
    printf("\n");
}

/* ---- reliable I/O helpers ---- */
static int recv_all(int fd, void *buf, size_t len) {
    size_t got = 0;
    while (got < len) {
        ssize_t n = recv(fd, (char *)buf + got, len - got, 0);
        if (n <= 0) return -1;
        got += (size_t)n;
    }
    return 0;
}

static int send_all(int fd, const void *buf, size_t len) {
    size_t sent = 0;
    while (sent < len) {
        ssize_t n = send(fd, (const char *)buf + sent, len - sent, 0);
        if (n <= 0) return -1;
        sent += (size_t)n;
    }
    return 0;
}

static int send_msg(int fd, const char *msg) {
    uint32_t len = (uint32_t)strlen(msg);
    uint32_t nlen = htonl(len);
    if (send_all(fd, &nlen, sizeof(nlen)) < 0) return -1;
    return send_all(fd, msg, len);
}

static int recv_msg(int fd, char *buf, size_t max) {
    uint32_t nlen;
    if (recv_all(fd, &nlen, sizeof(nlen)) < 0) return -1;
    uint32_t len = ntohl(nlen);
    if (len >= max) return -1;
    if (len > 0 && recv_all(fd, buf, len) < 0) return -1;
    buf[len] = '\0';
    return (int)len;
}

int main(void) {
    int sock;
    struct sockaddr_in server_addr;
    char buffer[BUFFER_SIZE];

    sock = socket(AF_INET, SOCK_STREAM, 0);
    if (sock < 0) {
        perror("Socket creation failed");
        exit(1);
    }

    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(PORT);
    server_addr.sin_addr.s_addr = inet_addr("127.0.0.1");

    if (connect(sock, (struct sockaddr *)&server_addr, sizeof(server_addr)) < 0) {
        perror("Connection failed");
        close(sock);
        exit(1);
    }

    printf("====================================\n");
    printf("        CONNECTED TO SERVER         \n");
    printf("====================================\n");

    /* ================= AUTHENTICATION PHASE ================= */
    char username[100];
    char password[100];

    printf("\n--- Authentication Required ---\n");
    printf("Enter Username: ");
    scanf(" %99s", username);

    // Clear newline left in buffer by scanf
    while (getchar() != '\n');

    printf("Enter Password: ");
    get_invisible_password(password, sizeof(password));

    // Send credentials to server
    if (send_msg(sock, username) < 0 || send_msg(sock, password) < 0) {
        printf("Failed to send credentials.\n");
        close(sock);
        exit(1);
    }

    // Receive authentication status result
    if (recv_msg(sock, buffer, sizeof(buffer)) < 0) {
        printf("Failed to get authentication response from server.\n");
        close(sock);
        exit(1);
    }

    if (strcmp(buffer, "AUTH_SUCCESS") != 0) {
        printf("Authentication failed: %s\n", buffer);
        close(sock);
        exit(1);
    }
    printf("Authentication successful!\n");

    /* ================= MENU ================= */
    while (1) {
        int choice;
        printf("\n========== MENU ==========\n");
        printf("1. Echo\n");
        printf("2. Palindrome Check\n");
        printf("3. Exit\n");
        printf("==========================\n");
        printf("Enter your choice: ");

        if (scanf("%d", &choice) != 1) {
            printf("Invalid input type.\n");
            while (getchar() != '\n');
            continue;
        }

        uint32_t nchoice = htonl((uint32_t)choice);
        if (send_all(sock, &nchoice, sizeof(nchoice)) < 0) {
            printf("Failed to send choice to server.\n");
            break;
        }

        /* ---------- Echo ---------- */
        if (choice == 1) {
            char message[200];
            printf("Enter message to echo: ");
            scanf(" %199[^\n]", message);
            send_msg(sock, message);
            if (recv_msg(sock, buffer, sizeof(buffer)) >= 0)
                printf("\nServer echoed : %s\n", buffer);
        }
        /* ---------- Palindrome Check ---------- */
        else if (choice == 2) {
            char str[200];
            printf("Enter string to check: ");
            scanf(" %199[^\n]", str);
            send_msg(sock, str);
            if (recv_msg(sock, buffer, sizeof(buffer)) >= 0)
                printf("\nServer result : %s\n", buffer);
        }
        /* ---------- Exit ---------- */
        else if (choice == 3) {
            if (recv_msg(sock, buffer, sizeof(buffer)) >= 0) {
                printf("\nServer response: %s\n", buffer);
            }
            printf("Disconnected from server.\n");
            break;
        }
        /* ---------- Invalid Options ---------- */
        else {
            if (recv_msg(sock, buffer, sizeof(buffer)) >= 0) {
                printf("Server response: %s\n", buffer);
            }
        }
    }

    close(sock);
    return 0;
}


