#include <stdio.h>
#include <string.h>

#define max 100
#define max_bit (max * 8)
#define max_stuff (max_bit * 2)

int data[max_bit], stuff[max_stuff], receive[max_stuff], destuff[max_bit];
char str[max];
char output[max];
int i,b;

void print(const char *label,int arr[],int n)
{
    printf("%s ",label);
    for(i=0;i<n;i++)
        printf("%d",arr[i]);
    printf("\n");
}

int main()
{
    int choice;

    while(1)
    {
        printf("\n___ Menu ___\n");
        printf("1. Standard String Transmission\n");
        printf("2. Simulate Transmission Error\n");
        printf("3. Exit\n");
        printf("Enter your choice : ");

        scanf("%d",&choice);
        getchar();

        if(choice==3)
        {
            printf("\nExiting>>>>\n");
            break;
        }

        switch(choice)
        {
        case 1:
        {
            int bit=0;
            int ones=0;
            int j=0;

            printf("\n--- Standard String Transmission ---\n");
            printf("Enter a string : ");
            fgets(str,sizeof(str),stdin);
            str[strcspn(str,"\n")]='\0';

            int len=strlen(str);

            for(i=0;i<len;i++)
            {
                unsigned char ch=str[i];

                for(b=7;b>=0;b--)
                    data[bit++]=(ch>>b)&1;
            }

            /* Even Parity */

            int parity=0;

            for(i=0;i<bit;i++)
                parity^=data[i];

            data[bit++]=parity;

            print("Original Data :",data,bit);

            /* Bit Stuffing */

            for(i=0;i<bit;i++)
            {
                stuff[j++]=data[i];

                if(data[i]==1)
                    ones++;
                else
                    ones=0;

                if(ones==5)
                {
                    stuff[j++]=0;
                    ones=0;
                }
            }

            int stufflen=j;

            print("Stuffed Frame :",stuff,stufflen);

            for(i=0;i<stufflen;i++)
                receive[i]=stuff[i];

            print("Transmitted Frame :",stuff,stufflen);
            print("Received Frame    :",receive,stufflen);

            /* Destuff */

            ones=0;
            j=0;

            for(i=0;i<stufflen;i++)
            {
                destuff[j++]=receive[i];

                if(receive[i]==1)
                    ones++;
                else
                    ones=0;

                if(ones==5)
                {
                    if(receive[i+1]==0)
                        i++;

                    ones=0;
                }
            }

            int destufflen=j;

            print("De-stuffed Frame :",destuff,destufflen);

            parity=0;

            for(i=0;i<destufflen;i++)
                parity^=destuff[i];

            if(parity==0)
                printf("Error Detection Status : No Error (Parity Matched)\n");
            else
                printf("Error Detection Status : Error Detected\n");

            int out=0;

            for(i=0;i<destufflen-1;i+=8)
            {
                unsigned char ch=0;

                for(b=0;b<8;b++)
                    ch=(ch<<1)|destuff[i+b];

                output[out++]=ch;
            }

            output[out]='\0';

            printf("Output String : %s\n",output);

            break;
        }

        case 2:
        {
            int bit=0;
            int ones=0;
            int j=0;

            printf("\n--- Error Simulation ---\n");
            printf("Enter a string : ");
            fgets(str,sizeof(str),stdin);
            str[strcspn(str,"\n")]='\0';

            int len=strlen(str);

            for(i=0;i<len;i++)
            {
                unsigned char ch=str[i];

                for(b=7;b>=0;b--)
                    data[bit++]=(ch>>b)&1;
            }

            int parity=0;

            for(i=0;i<bit;i++)
                parity^=data[i];

            data[bit++]=parity;

            for(i=0;i<bit;i++)
            {
                stuff[j++]=data[i];

                if(data[i]==1)
                    ones++;
                else
                    ones=0;

                if(ones==5)
                {
                    stuff[j++]=0;
                    ones=0;
                }
            }

            int stufflen=j;

            print("Original Data :",data,bit);
            print("Stuffed Frame :",stuff,stufflen);

            for(i=0;i<stufflen;i++)
                receive[i]=stuff[i];

            int ch;

            printf("\n1. Single Bit Error\n");
            printf("2. Multiple Bit Error\n");
            printf("Enter choice : ");
            scanf("%d",&ch);

            if(ch==1)
            {
                int pos;

                printf("Enter Bit Position : ");
                scanf("%d",&pos);

                if(pos>=0 && pos<stufflen)
                    receive[pos]^=1;
            }
            else
            {
                int p1,p2;

                printf("Enter First Bit Position : ");
                scanf("%d",&p1);

                printf("Enter Second Bit Position : ");
                scanf("%d",&p2);

                if(p1>=0 && p1<stufflen)
                    receive[p1]^=1;

                if(p2>=0 && p2<stufflen)
                    receive[p2]^=1;
            }

            print("Transmitted Frame :",stuff,stufflen);
            print("Received Frame    :",receive,stufflen);

            ones=0;
            j=0;

            for(i=0;i<stufflen;i++)
            {
                destuff[j++]=receive[i];

                if(receive[i]==1)
                    ones++;
                else
                    ones=0;

                if(ones==5)
                {
                    if(receive[i+1]==0)
                        i++;

                    ones=0;
                }
            }

            int destufflen=j;

            print("De-stuffed Frame :",destuff,destufflen);

            parity=0;

            for(i=0;i<destufflen;i++)
                parity^=destuff[i];

            if(parity==0)
                printf("Error Detection Status : No Error (Parity Matched)\n");
            else
                printf("Error Detection Status : Error Detected (Parity Mismatch)\n");

            getchar();

            break;
        }

        default:
            printf("Invalid Choice\n");
        }
    }

    return 0;
}
