#include <limits.h>
#include <stdio.h>
#include <stdlib.h>

int networkDelayTime(int** times, int timesSize, int* timesColSize, int n, int k) {
  int g[101][101];
  int dist[101];
  int vis[101];
  const int inf = 1 << 29;

  for (int i = 1; i <= n; i++) {
    dist[i] = inf;
    vis[i] = 0;
    for (int j = 1; j <= n; j++) {
      g[i][j] = inf;
    }
  }

  for (int i = 0; i < timesSize; i++) {
    int u = times[i][0];
    int v = times[i][1];
    int w = times[i][2];
    g[u][v] = w;
  }

  dist[k] = 0;

  for (int i = 0; i < n; i++) {
    int t = -1;
    for (int j = 1; j <= n; j++) {
      if (!vis[j] && (t == -1 || dist[t] > dist[j])) {
        t = j;
      }
    }

    if (t == -1 || dist[t] == inf) {
      break;
    }

    vis[t] = 1;

    for (int j = 1; j <= n; j++) {
      if (dist[t] + g[t][j] < dist[j]) {
        dist[j] = dist[t] + g[t][j];
      }
    }
  }

  int ans = 0;
  for (int i = 1; i <= n; i++) {
    if (dist[i] == inf) {
      return -1;
    }
    if (dist[i] > ans) {
      ans = dist[i];
    }
  }

  return ans;
}
